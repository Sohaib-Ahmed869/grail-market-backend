# ── required ────────────────────────────────────────────────────────────────
# Where the vision service is. Must include the scheme.
VISION_URL=http://localhost:8100
PORT=8180

# ── pricing sources ─────────────────────────────────────────────────────────
# Pokemon sold comps, per grade. English sets only.
#
# One key, or several separated by commas. Each key keeps its OWN budget and
# its own breaker, so one key running out does not disable the rest, and the
# pool drains the fullest key first rather than taking every key to empty at
# once. A single key behaves exactly as it always did.
PPT_API_KEY=

# Cards per request for the refresh job. The provider bills PER CARD RETURNED,
# so this is literally the price of a lookup. The scan path asks for 3 because
# it searches by fuzzy text and has to pick the right card out of the results;
# the refresh job already knows the exact name, set and number, so it asks for
# 1 and pays a third as much. Raise it only if ingest starts missing cards.
PPT_INGEST_PAGE_SIZE=1

# Live listings, and the marketplace-deletion compliance endpoint.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_VERIFICATION_TOKEN=
EBAY_ENDPOINT_URL=

# Names a card the catalogues cannot, and reads a printing off the artwork.
GEMINI_API_KEY=

# Optional catalogues.
JUSTTCG_API_KEY=
APITCG_API_KEY=
CARDGRADER_API_KEY=
# CardGrader bills ~$0.20/call and is OFF unless this is a positive number.
# It is a graded-price backup only; without it an unpriced card falls through
# to live asks, which is real data. See src/scans/cardgrader.ts.
CARDGRADER_DAILY_MAX=0

# ── storage ─────────────────────────────────────────────────────────────────
# Shared price cache. Without it the cache is local-only and per-process.
DATABASE_URL=

# ── tuning ──────────────────────────────────────────────────────────────────
# Cap the longest edge of an uploaded image. 0 = off, and off is correct:
# shrinking to 2000px once lost a collector number and mispriced a card by 30x.
MAX_INPUT_PX=0
